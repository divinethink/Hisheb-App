# কপি করে .env.staging / .env.production বানান (Git-এ যাবে না) — .env.local (local dev) বা .env.staging/.env.production
VITE_FIREBASE_API_KEY=
# Hosting-এর নিজের ডোমেইন দিন (যেমন hisebi.web.app) — cross-domain sign-in সমস্যা এড়াতে; OAuth client-এ https://<ডোমেইন>/__/auth/handler redirect URI লাগবে
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# (ঐচ্ছিক — Storage/Messaging এখন ব্যবহৃত না)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_APPCHECK_SITE_KEY=
# owner-এর Gmail (client-side 'Access restricted' চেক; আসল enforcement firestore.rules-এ)
VITE_OWNER_EMAIL=
# শুধু local/Staging-এ — Production .env-এ কখনো না (Git-এ কখনো না)
VITE_APPCHECK_DEBUG_TOKEN=

