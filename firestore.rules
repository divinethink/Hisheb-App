rules_version = '2';
// একটাই match + validWrite(col, data), default-deny (Architecture Plan §৩, B7/R1)।
// ⚠️ DEPLOY-এর আগে tuhin.msg@gmail.com নিজের Gmail দিয়ে বদলান (Staging ও Production আলাদা)।
// না বদলালে কেউই ঢুকতে পারবে না — নিরাপদ ডিফল্ট।
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
             && request.auth.token.email == 'OWNER_GMAIL'
             && request.auth.token.email_verified == true;
    }
    function nameOk(d) {
      return d.name is string && d.name.size() > 0;
    }
    function posInt(v) {
      return v is int && v > 0;
    }
    // ঐচ্ছিক ফিল্ড: না থাকলে/null হলে ঠিক; থাকলে টাইপ ও সীমা মানতে হবে (investments ধাপ ১, additive)
    function optPosInt(d, k) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] > 0);
    }
    function optStr(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    // কোম্পানি-লোগো: ছোট webp/png/jpeg data-URL (≤৪০০০০ অক্ষর), svg নয় — validation/investmentCompanySchema.ts-এর সাথে মিল
    function logoOk(d) {
      return !('logo' in d) || d.logo == null
             || (d.logo is string && d.logo.size() <= 40000
                 && d.logo.matches('^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+$'));
    }
    function validWrite(col, d) {
      return (col == 'transactions'
                ? (posInt(d.amountMinor) && d.type in ['income', 'expense']
                   && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
              : col in ['labels', 'categories'] ? nameOk(d)
              : col == 'customLedgers' ? (nameOk(d) && d.kind in ['deposit', 'investment'])
              : col == 'debts' ? posInt(d.totalAmountMinor)
              : col == 'investments'
                ? (posInt(d.principalMinor) && optPosInt(d, 'round') && optStr(d, 'companyId', 100)
                   && optStr(d, 'platformNo', 30) && optStr(d, 'contractFileId', 100) && optStr(d, 'contractName', 120))
              : col == 'investmentCompanies'
                ? (nameOk(d) && d.name.size() <= 60 && optStr(d, 'medium', 60) && logoOk(d))
              : col == 'homeDeposits' ? posInt(d.amountMinor)
              : col == 'gpfEntries'
                ? (posInt(d.amountMinor) && d.type in ['contribution', 'interest', 'withdrawal'])
              : col == 'accountBalances' ? d.balanceMinor is int
              : col == 'netWorthSnapshots' ? d.totalAssetsMinor is int
              : col == 'zakatPayments' ? posInt(d.amountMinor)
              : col == 'historicalYearlyTotals'
                ? (d.totalIncomeMinor is int && d.totalExpenseMinor is int && d.totalDepositMinor is int)
              : true);
    }
    match /users/{uid}/{col}/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validWrite(col, request.resource.data);
    }
  }
}
